# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001

# ── JWT Auth ───────────────────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_secreta_muy_larga_y_aleatoria

# ── Supabase PostgreSQL ────────────────────────────────────────────────────────
# Obtén estas credenciales desde tu proyecto en https://supabase.com
SUPABASE_URL=https://tu-proyecto-id.supabase.co
SUPABASE_KEY=tu_anon_public_key_aqui

# ── Web Push Notifications (VAPID) ─────────────────────────────────────────────
# Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=tu_clave_publica_vapid
VAPID_PRIVATE_KEY=tu_clave_privada_vapid
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# ── Frontend URL ────────────────────────────────────────────────────────────────
# URL de tu frontend desplegado (para CORS y notificaciones push)
FRONTEND_URL=https://tu-frontend.netlify.app

# ── Groq AI API ─────────────────────────────────────────────────────────────────
# Opcional: para funcionalidades avanzadas de IA
# Obtén tu key en https://console.groq.com
GROQ_API_KEY=gsk_tu_clave_groq_aqui
